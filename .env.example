# ==============================================================================
# FIELD SHIFT – Environment Configuration Template
# Copy this file to .env and populate with your project secrets.
# NEVER commit real secrets or expose server-only keys in VITE_ variables.
# ==============================================================================

# --- Frontend / Browser-Safe Supabase Configuration ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# --- Server-Side Secrets (NEVER prefix with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-google-gemini-api-key

# --- NASA Earthdata Login Credentials (Server-Side Only) ---
NASA_EARTHDATA_USERNAME=your-earthdata-username
NASA_EARTHDATA_PASSWORD=your-earthdata-password

# --- Separate Python FastAPI ML Service (Replit / Server-Side Only) ---
ML_API_URL=https://your-field-shift-ml-service.example.com
ML_API_SECRET=your-shared-ml-service-bearer-secret

# --- Hosting Environment ---
APP_URL=http://localhost:3000
